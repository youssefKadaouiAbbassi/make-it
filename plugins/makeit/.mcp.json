{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.12.0", "--no-performance-crux"],
      "env": { "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1" }
    },
    "docs": {
      "command": "npx",
      "args": ["-y", "@arabold/docs-mcp-server@3.4.1", "--read-only"],
      "env": { "DOCS_MCP_TELEMETRY": "false", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1" }
    }
  }
}
