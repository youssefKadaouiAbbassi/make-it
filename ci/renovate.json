{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinDigestsDisabled"
  ],
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Catalog entries pinned to a tag: github source (repo + ref + sha)",
      "managerFilePatterns": [
        "/^\\.claude-plugin/marketplace\\.json$/"
      ],
      "matchStrings": [
        "\"repo\":\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>[^\"]*?v?[0-9][^\"]*)\",\\s*\"sha\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Catalog entries pinned to a branch: github source (repo + ref main + sha)",
      "managerFilePatterns": [
        "/^\\.claude-plugin/marketplace\\.json$/"
      ],
      "matchStrings": [
        "\"repo\":\\s*\"(?<packageName>[^\"]+)\",\\s*\"ref\":\\s*\"(?<currentValue>main|master)\",\\s*\"sha\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{packageName}}"
    },
    {
      "customType": "regex",
      "description": "Catalog entries pinned to a tag: url or git-subdir source (url + path? + ref + sha)",
      "managerFilePatterns": [
        "/^\\.claude-plugin/marketplace\\.json$/"
      ],
      "matchStrings": [
        "\"url\":\\s*\"https://github\\.com/(?<packageName>[^\"]+?)(?:\\.git)?\",(?:\\s*\"path\":\\s*\"[^\"]*\",)?\\s*\"ref\":\\s*\"(?<currentValue>[^\"]*?v?[0-9][^\"]*)\",\\s*\"sha\":\\s*\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Pinned container images and tool versions in workflows",
      "managerFilePatterns": [
        "/^ci/\\.github/workflows/.+\\.ya?ml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?",
        "docker://(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?",
        "docker run [^\\n]*?(?<depName>sitespeedio/sitespeed\\.io):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "npx-launched MCP servers pinned by version in .mcp.json files",
      "managerFilePatterns": [
        "/(^|/)\\.mcp\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:@[a-z0-9-]+/)?[a-z0-9-]+)@(?<currentValue>[0-9][^\"]*)\""
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "GitHub Actions: pinned by sha, version in the comment",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Prefixed release tags: compare the version after the prefix, never cross prefixes (Impeccable also tags engine-v*)",
      "matchPackageNames": [
        "ChromeDevTools/chrome-devtools-mcp",
        "pbakaus/impeccable"
      ],
      "versioning": "regex:^(?<compatibility>.*-v)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true
}
